# Copy to .env if your FastAPI backend runs somewhere other than localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps). Copy to frontend/.env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# For local testing against the Firebase Auth Emulator only
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
